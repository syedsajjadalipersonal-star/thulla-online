# Copy to .env and replace the values. .env is not committed.
POSTGRES_PASSWORD=change-me
NAKAMA_CONSOLE_PASSWORD=change-me
# Shared by Nakama and the bot runner (npm run bots), so only your bots can take seats.
BOT_SECRET=change-me
# Seconds per move. Optional; 60 if not set.
# TURN_SECONDS=60

# On the server only (deploy/setup-server.sh writes these). Locally Nakama's defaults are used.
# DOMAIN=thulla.duckdns.org
# NAKAMA_CONSOLE_USERNAME=owner
# NAKAMA_SERVER_KEY=...
# SESSION_ENCRYPTION_KEY=...
# SESSION_REFRESH_ENCRYPTION_KEY=...
# CONSOLE_SIGNING_KEY=...
# RUNTIME_HTTP_KEY=...
